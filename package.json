    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "7.4.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  }
}
